# Servidor (PORT es opcional; Render la configura automáticamente)
PORT=
NODE_ENV=

# MongoDB: incluir el nombre de la base en la URI
MONGODB_URI=

# URL pública del frontend, sin /api: local http://localhost:5173
BETTER_AUTH_URL=
# Generar un secreto aleatorio de al menos 32 caracteres
BETTER_AUTH_SECRET=

# OAuth App de GitHub: usar aplicaciones distintas para local y producción
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Opcional: habilita Google al completar ambas variables
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Solo para npm run seed. Dos cuentas exclusivas para la corrección.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Asistente: cuotas gratuitas, sin activar facturación
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
